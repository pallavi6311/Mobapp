NODE_ENV=production
PORT=3000

# Firebase Admin SDK
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"

# Firebase Storage bucket (for delivery photo uploads)
# Usually: <project-id>.appspot.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Payment Gateway (optional — app runs with mock payments without these)
# To go live: get keys from Razorpay dashboard (dashboard.razorpay.com) — no KYC for test mode
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_key_secret

# App Secret
APP_SECRET=your-random-secret-string
